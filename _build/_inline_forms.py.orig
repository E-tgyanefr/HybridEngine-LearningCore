import io
import re
import sys

sys.stdout.reconfigure(encoding="utf-8", errors="replace")
B = r"D:\Users\etgya\Desktop\Project\引擎\LearnCode\_build"
G = B + r"\_gen_compiled.py"

t = io.open(G, encoding="utf-8").read()
内联 = io.open(B + r"\_forms_port.py", encoding="utf-8").read()

# ① 砍掉通用生成器里原有的形态函数（从 `def 头(` 之后到 `形态表 = {`）
起 = t.index("def 头(说明: str, 名: str) -> str:")
止 = t.index("形态表 = {")
保留头 = t[起:起 + t[起:止].index("def 过(")]
新段 = 保留头 + "\n" + 内联.split("\n\n", 1)[1] + "\n\n"

# ② 形态表重写（14 种）
表 = """形态表 = {
    "输出逐行": 形_输出逐行,
    "输出不含": 形_输出不含,
    "代码包含": 形_代码包含,
    "代码不含": 形_代码不含,
    "写了函数": 形_写了函数,
    "函数用例": 形_函数用例,
    "字符串用例": 形_字符串用例,
    "指针用例": 形_指针用例,
    "数组合用例": 形_数组合用例,
    "统计用例": 形_统计用例,
    "可编译": 形_可编译,
    "带main就能编译": 形_带main就能编译,
    "需要输入": 形_需要输入,
    "顺序": 形_顺序,
}

#: 形态函数里写的 `{K}` / `{L}` / `{R}` 是**占位符**，生成时换成本线真正的类名。
#  ⚠ 为什么用 .replace 而不是 f-string：形态函数返回的 C# 代码里有大量 `{ }`
#    （C# 的花括号），f-string 会把它们当占位符 ⇒ 一堆 KeyError。
#    用三个**独特的** token 做替换就不会撞。
def 换名(文: str) -> str:
    return 文.replace("{K}", K).replace("{L}", L).replace("{R}", R)

"""
t = t[:起] + 新段 + 表 + t[止 + len("形态表 = {"):]
# 上面那句把原表也切进来了，简单点：直接截到原表结束
t2 = io.open(G, encoding="utf-8").read()

io.open(G, "w", encoding="utf-8", newline="").write(t)
print("  已写入（%d 字符）" % len(t))
