<?xml version="1.0" encoding="utf-8"?>
<!-- 网络安全配置 —— **只对 127.0.0.1 开明文 HTTP 的口子**。
     ────────────────────────────────────────────────────────────────
     ⚠⚠ 为什么需要：安卓 9（API 28）起**默认禁止明文 HTTP**。
       而我们的界面就是 `http://127.0.0.1:<端口>/`（见 LocalServer.cs），
       于是 WebView 直接报
           net::ERR_CLEARTEXT_NOT_PERMITTED
       这是真机实测撞到的第二个 WebView 错误
       （第一个是 file:// 下 fetch 被禁，见 LocalServer.cs 的注释）。

     ⚠ 为什么不用 `android:usesCleartextTraffic="true"`：
       那是**全局**放开 —— 这个应用对任何 http 站点都不设防了。
       一个本地教学应用没有任何理由放松全局的传输安全。
       这里只给 `127.0.0.1` 开口子，其它域名仍然按默认（禁止明文）走。 -->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <!-- ⚠ 写 `<domain>127.0.0.1</domain>` 而不是 `localhost`：
         安卓的 domain 匹配是对**主机名**做的，而我们连的就是 IP 字面量。
         只写 localhost 的话 127.0.0.1 仍然会被拦。 -->
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
